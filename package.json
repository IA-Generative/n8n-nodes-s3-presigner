{
  "name": "n8n-nodes-s3-presigner",
  "version": "0.1.1",
  "description": "Custom n8n node for S3 Presigned URLs",
  "homepage": "https://github.com/IA-Generative/n8n-nodes-s3-presigner",
	"author": {
		"name": "sebthemonster",
		"email": "sebastien@sebthemonster.com"
	},
	"license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IA-Generative/n8n-nodes-s3-presigner.git"
  },
  "scripts": {
    "build": "n8n-node build && node scripts/bundle.js",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "nodes": ["dist/nodes/S3Presigner/S3Presigner.node.js"]
  },
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@smithy/node-http-handler": "^4.0.0",
    "@n8n/node-cli": "*",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "keywords": ["n8n-community-node-package"]
}
